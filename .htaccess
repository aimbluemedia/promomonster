# Root fallback for hosts where the document root cannot be pointed at public/.
#
# If you CAN set the document root to public/, this file is never used and the
# stricter rules in public/.htaccess apply instead.
#
# Everything is mapped into public/ so that app/, database/ and docs/ are never
# served, and so a request for / finds a front controller instead of an empty
# directory (which is what produces "403 Forbidden").

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Already inside public/ — leave it to public/.htaccess.
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # The operator tools live at the root and must not be rewritten away.
    #
    # Named one at a time until a fourth was added and this list was not, so
    # /support.php answered with the site's own 404 page -- the tool for
    # diagnosing a broken deployment, unreachable because of the deployment.
    # Any PHP file that really exists in the project root is served as itself
    # now, which fixes the whole class rather than the one instance.
    #
    # Scoped tightly on purpose: ^[^/]+\.php$ matches the project root only,
    # never a path, so nothing under app/ or storage/ can be reached this way,
    # and -f means only files that are actually there.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^[^/]+\.php$ - [L]

    # Serve a real file under /assets/ from the project root if one is there.
    #
    # Without this, EVERY request is mapped into public/, so an image uploaded
    # to public_html/assets/img/ is unreachable — which is where the documented
    # layout puts it, and where anyone would sensibly put it. Both locations now
    # work the same way.
    #
    # Scoped to /assets/ deliberately: a blanket "serve any file that exists"
    # would hand out app/config.php, database passwords and all.
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Map every other request into public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, at least serve the fallback front controller for /.
DirectoryIndex index.php

Options -Indexes

# .git in the web root exposes the entire source history, credentials in old
# commits included. Deny it, and delete the directory from the server.
RedirectMatch 404 /\.git(/|$)

# Belt and braces: never serve project files even if a rewrite is bypassed.
<FilesMatch "\.(sql|md|json|lock|example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
